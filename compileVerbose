
#!/usr/bin/env bash

set -Eeuxo pipefail

echo "========================================"
echo " AGMM BUILD SCRIPT"
echo "========================================"

echo
echo "[1/5] Cleaning..."
make clean V=1

echo
echo "[2/5] Building (16 parallel jobs)..."
make -j16 V=1

echo
echo "[3/5] Creating distribution..."
make dist V=1

echo
echo "[4/5] Installing..."
make install V=1

echo
echo "[5/5] Copying plugin to Rack 2..."

PLUGIN="dist/AGMM-2.0.0-win-x64.vcvplugin"
DEST="/c/Users/andreas/AppData/Local/Rack2/plugins-win-x64"

if [[ ! -f "$PLUGIN" ]]; then
    echo "ERROR: Plugin file not found: $PLUGIN"
    exit 1
fi

mkdir -p "$DEST"
cp -v "$PLUGIN" "$DEST/"

echo
echo "========================================"
echo " BUILD COMPLETED SUCCESSFULLY!"
echo "========================================"
